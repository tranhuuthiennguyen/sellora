{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:keys",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "generate": "npx drizzle-kit generate --config=src/db/drizzle.config.ts",
    "migrate": "npx drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "push": "npx drizzle-kit push --config=src/db/drizzle.config.ts",
    "seed": "tsx ./src/db/seed/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "copy:keys": "copyfiles -u 1 \"src/**/*.key\" dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/jwt": "^10.0.0",
    "@fastify/secure-session": "^8.2.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sellora/shared": "^1.0.0",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.44.6",
    "drizzle-seed": "^0.3.1",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "module-alias": "^2.2.3",
    "pg": "^8.16.3",
    "pino": "^9.13.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@sellora/eslint-config": "^0.0.0",
    "@sellora/typescript-config": "^0.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.37.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "_moduleAliases": {
    "@": "dist",
    "@certs": "dist/certs",
    "@config": "dist/config",
    "@contants": "dist/constants",
    "@db": "dist/db",
    "@modules": "dist/modules",
    "@plugins": "dist/plugins",
    "@schemas": "dist/schemas",
    "@utils": "dist/utils"
  }
}
