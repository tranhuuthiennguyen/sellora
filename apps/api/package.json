{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:keys",
    "start": "node dist/server.js",
    "dev": "tsx watch src --env-file=.env | pino-pretty",
    "db": "dbmate h",
    "db:create-migration": "dbmate new",
    "db:migrate": "dbmate -e DATABASE_URL up",
    "db:migrate:down": "dbmate -e DATABASE_URL down",
    "db:create-seed": "dbmate -e DATABASE_URL -d ./db/seeds/ new",
    "db:seed": "dbmate --migrations-table 'seed_migrations' -e DATABASE_URL -d ./db/seeds/ up",
    "test": "jest",
    "test:watch": "jest --watch",
    "copy:keys": "copyfiles -u 1 \"src/**/*.key\" dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/awilix": "^8.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/request-context": "^6.2.1",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/under-pressure": "^9.0.3",
    "@gquittet/graceful-server": "^6.0.2",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.1.6",
    "@sellora/shared": "^1.0.0",
    "@types/redis": "^4.0.10",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "awilix": "^12.0.5",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.0.3",
    "env-schema": "^6.1.0",
    "fast-jwt": "^6.1.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "graphql": "^16.12.0",
    "mercurius": "^16.6.0",
    "moment": "^2.30.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "postgres": "^3.4.7",
    "ramda": "^0.32.0",
    "redis": "^5.10.0",
    "tsconfig": "^7.0.0",
    "typebox": "^1.0.71",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@sellora/eslint-config": "^0.0.0",
    "@sellora/typescript-config": "^0.0.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "copyfiles": "^2.4.1",
    "dbmate": "^2.28.0",
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "json-schema-to-ts": "^3.1.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1",
    "resolve-tspaths": "^0.8.23",
