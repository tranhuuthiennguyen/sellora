{
  "name": "@sellora/shared",
  "version": "1.0.0",
  "description": "shared package",
  "license": "ISC",
  "author": "thien",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.js"
    },
    "./user": {
      "import": "./dist/user/index.js",
      "require": "./dist/user/index.js"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "require": "./dist/validation/index.js"
    },
    "./http": {
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.js"
    },
    "./lib": {
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.js"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@sellora/eslint-config": "*",
    "@sellora/typescript-config": "*",
    "@types/node": "^22.15.3",
    "eslint": "^9.34.0",
    "typescript": "5.9.2"
  }
}
